@model IEnumerable<SmartClassRoom.Web.Models.Entities.Academic.Course>
@using SmartClassRoom.Web.Models.ViewModels.Common
@{
    ViewData["Title"] = "Courses";
    ViewData["PageTitle"] = "Courses";
    ViewData["PageIcon"] = "journal";
    ViewData["PageDescription"] = "Manage all courses in the system";
    Layout = "~/Views/Shared/_AdminLayoutWithSidebar.cshtml";
}

@section PageActions {
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add Course
    </a>
}

<!-- Filter Card -->
<div class="card filter-card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-4">
                <label for="departmentId" class="form-label">Department</label>
                <select name="departmentId" id="departmentId" class="form-select">
                    <option value="">All Departments</option>
                    @foreach (var dept in ViewBag.Departments as SelectList)
                    {
                        <option value="@dept.Value" selected="@(dept.Value == ViewBag.DepartmentId?.ToString())">
                            @dept.Text
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label for="isActive" class="form-label">Status</label>
                <select name="isActive" id="isActive" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="true" selected="@(ViewBag.IsActive == true)">Active</option>
                    <option value="false" selected="@(ViewBag.IsActive == false)">Inactive</option>
                </select>
            </div>

            <div class="col-md-5 d-flex align-items-end justify-content-end gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Clear
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Courses Table -->
<div class="card">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="users-table">
                    <thead>
                        <tr>
                            <th asp-sortable-column="Code" asp-column-display="Code"></th>
                            <th asp-sortable-column="Name" asp-column-display="Course Name"></th>
                            <th asp-sortable-column="Department" asp-column-display="Department"></th>
                            <th asp-sortable-column="Credits" asp-column-display="Credits"></th>
                            <th asp-sortable-column="CourseType" asp-column-display="Type"></th>
                            <th asp-sortable-column="Status" asp-column-display="Status"></th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-primary">@course.Code</span>
                                </td>
                                <td><strong>@course.Name</strong></td>
                                <td>@course.Department?.Name</td>
                                <td>
                                    <span class="badge bg-info text-dark">@course.Credits Credits</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(course.CourseType))
                                    {
                                        <span class="badge bg-secondary">@course.CourseType</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (course.IsActive)
                                    {
                                        <span class="status-badge active">
                                            <i class="bi bi-check-circle me-1"></i>Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge inactive">
                                            <i class="bi bi-x-circle me-1"></i>Inactive
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a asp-action="Details" asp-route-id="@course.Id" class="action-btn info" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@course.Id" class="action-btn warning" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (course.IsActive)
                                        {
                                            <form asp-action="Deactivate" asp-route-id="@course.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="action-btn danger" title="Deactivate"
                                                        onclick="return confirm('Are you sure you want to deactivate this course?')">
                                                    <i class="bi bi-slash-circle"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="Activate" asp-route-id="@course.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="action-btn success" title="Activate"
                                                        onclick="return confirm('Are you sure you want to activate this course?')">
                                                    <i class="bi bi-check-circle"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (ViewBag.Pagination != null)
            {
                @await Html.PartialAsync("_Pagination", ViewBag.Pagination as SmartClassRoom.Web.Models.ViewModels.Common.PaginationViewModel)
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox display-1 text-muted"></i>
                <p class="text-muted mt-3">No courses found.</p>
                <a asp-action="Create" class="btn btn-primary mt-2">
                    <i class="bi bi-plus-circle"></i> Add First Course
                </a>
            </div>
        }
    </div>
</div>
