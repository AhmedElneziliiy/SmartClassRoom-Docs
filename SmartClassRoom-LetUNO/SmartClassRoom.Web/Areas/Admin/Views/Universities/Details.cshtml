@model SmartClassRoom.Web.Models.Entities.Academic.University

@{
    ViewData["Title"] = "University Details";
    ViewData["PageTitle"] = Model.Name;
    ViewData["PageIcon"] = "building";
    Layout = "~/Views/Shared/_AdminLayoutWithSidebar.cshtml";
    var statistics = ViewBag.Statistics as SmartClassRoom.Web.Services.Interfaces.UniversityStatistics;
}

@section PageActions {
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
        <i class="bi bi-pencil"></i> Edit
    </a>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
}

<div class="row g-4">
    <!-- Left Column: University Info -->
    <div class="col-lg-4">
        <div class="card detail-card">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="bi bi-info-circle"></i> University Information
                </h5>

                <div class="detail-group">
                    <label>Name</label>
                    <p><strong>@Model.Name</strong></p>
                </div>

                @if (!string.IsNullOrEmpty(Model.Code))
                {
                    <div class="detail-group">
                        <label>Code</label>
                        <p><span class="badge bg-secondary">@Model.Code</span></p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Address))
                {
                    <div class="detail-group">
                        <label>Address</label>
                        <p>@Model.Address</p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Phone))
                {
                    <div class="detail-group">
                        <label>Phone</label>
                        <p><i class="bi bi-telephone"></i> @Model.Phone</p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Email))
                {
                    <div class="detail-group">
                        <label>Email</label>
                        <p><i class="bi bi-envelope"></i> @Model.Email</p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Website))
                {
                    <div class="detail-group">
                        <label>Website</label>
                        <p><i class="bi bi-globe"></i> <a href="@Model.Website" target="_blank">@Model.Website</a></p>
                    </div>
                }

                <div class="detail-group">
                    <label>Status</label>
                    <p>
                        @if (Model.IsActive)
                        {
                            <span class="status-badge status-active">Active</span>
                        }
                        else
                        {
                            <span class="status-badge status-inactive">Inactive</span>
                        }
                    </p>
                </div>

                <div class="detail-group">
                    <label>Created Date</label>
                    <p>@Model.CreatedAt.ToString("MMMM dd, yyyy")</p>
                </div>

                <div class="detail-actions mt-4">
                    @if (Model.IsActive)
                    {
                        <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-warning btn-sm w-100"
                                    onclick="return confirm('Are you sure you want to deactivate this university? Make sure all departments are inactive first.')">
                                <i class="bi bi-slash-circle"></i> Deactivate University
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Activate" asp-route-id="@Model.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success btn-sm w-100"
                                    onclick="return confirm('Are you sure you want to activate this university?')">
                                <i class="bi bi-check-circle"></i> Activate University
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Statistics & Departments -->
    <div class="col-lg-8">
        <!-- Statistics Card -->
        @if (statistics != null)
        {
            <div class="card stats-card mb-4">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-graph-up"></i> Statistics
                    </h5>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <div class="stat-item">
                                <div class="stat-icon bg-primary">
                                    <i class="bi bi-diagram-3"></i>
                                </div>
                                <div class="stat-details">
                                    <h3>@statistics.DepartmentCount</h3>
                                    <p>Total Departments</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-item">
                                <div class="stat-icon bg-success">
                                    <i class="bi bi-check-circle"></i>
                                </div>
                                <div class="stat-details">
                                    <h3>@statistics.ActiveDepartmentCount</h3>
                                    <p>Active Departments</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-item">
                                <div class="stat-icon bg-info">
                                    <i class="bi bi-people"></i>
                                </div>
                                <div class="stat-details">
                                    <h3>@statistics.TotalStudentCount</h3>
                                    <p>Total Students</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-item">
                                <div class="stat-icon bg-warning">
                                    <i class="bi bi-person-badge"></i>
                                </div>
                                <div class="stat-details">
                                    <h3>@statistics.TotalTeacherCount</h3>
                                    <p>Total Teachers</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Departments List -->
        <div class="card data-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-diagram-3"></i> Departments
                    </h5>
                    <a asp-area="Admin" asp-controller="Departments" asp-action="Create" asp-route-universityId="@Model.Id" class="btn btn-sm btn-primary">
                        <i class="bi bi-plus-circle"></i> Add Department
                    </a>
                </div>

                @if (Model.Departments.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Code</th>
                                    <th>Head</th>
                                    <th>Students</th>
                                    <th>Teachers</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dept in Model.Departments.OrderBy(d => d.Name))
                                {
                                    <tr>
                                        <td><strong>@dept.Name</strong></td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(dept.Code))
                                            {
                                                <span class="badge bg-secondary">@dept.Code</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">N/A</span>
                                            }
                                        </td>
                                        <td>
                                            @if (dept.HeadOfDepartment != null)
                                            {
                                                <span>@dept.HeadOfDepartment.FullName</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not Assigned</span>
                                            }
                                        </td>
                                        <td><span class="badge bg-info">@dept.Students.Count</span></td>
                                        <td><span class="badge bg-warning">@dept.Teachers.Count</span></td>
                                        <td>
                                            @if (dept.IsActive)
                                            {
                                                <span class="status-badge status-active">Active</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-inactive">Inactive</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a asp-area="Admin" asp-controller="Departments" asp-action="Details" asp-route-id="@dept.Id"
                                               class="btn btn-sm btn-outline-primary" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-area="Admin" asp-controller="Departments" asp-action="Edit" asp-route-id="@dept.Id"
                                               class="btn btn-sm btn-outline-secondary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state-small">
                        <i class="bi bi-diagram-3"></i>
                        <p>No departments found for this university.</p>
                        <a asp-area="Admin" asp-controller="Departments" asp-action="Create" asp-route-universityId="@Model.Id" class="btn btn-sm btn-primary">
                            <i class="bi bi-plus-circle"></i> Add First Department
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
