@model IEnumerable<SmartClassRoom.Web.Models.Entities.Academic.Term>

@{
    ViewData["Title"] = "Terms";
    ViewData["PageTitle"] = "Academic Terms";
    ViewData["PageIcon"] = "calendar3";
    ViewData["PageDescription"] = "Manage academic terms and semesters";
    Layout = "~/Views/Shared/_AdminLayoutWithSidebar.cshtml";
}

@section PageActions {
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add Term
    </a>
}

<!-- Filter Card -->
<div class="card filter-card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3" id="filterForm">
            <div class="col-md-4">
                <label for="status" class="form-label">Status</label>
                <select name="status" id="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Upcoming" selected="@(ViewBag.SelectedStatus == "Upcoming")">Upcoming</option>
                    <option value="Active" selected="@(ViewBag.SelectedStatus == "Active")">Active</option>
                    <option value="Completed" selected="@(ViewBag.SelectedStatus == "Completed")">Completed</option>
                </select>
            </div>

            <div class="col-md-4">
                <label for="isActive" class="form-label">Active Status</label>
                <select name="isActive" id="isActive" class="form-select">
                    <option value="">All</option>
                    <option value="true" selected="@(ViewBag.SelectedIsActive == true)">Active</option>
                    <option value="false" selected="@(ViewBag.SelectedIsActive == false)">Inactive</option>
                </select>
            </div>

            <div class="col-md-4 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Clear
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Terms Table -->
<div class="card">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="users-table">
                    <thead>
                        <tr>
                            <th asp-sortable-column="Name" asp-column-display="Term Name"></th>
                            <th asp-sortable-column="Code" asp-column-display="Code"></th>
                            <th asp-sortable-column="StartDate" asp-column-display="Start Date"></th>
                            <th asp-sortable-column="EndDate" asp-column-display="End Date"></th>
                            <th asp-sortable-column="Status" asp-column-display="Status"></th>
                            <th>Offerings</th>
                            <th>Active</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var term in Model)
                        {
                            <tr>
                                <td><strong>@term.Name</strong></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(term.Code))
                                    {
                                        <span class="badge bg-secondary">@term.Code</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td>@term.StartDate.ToString("MMM dd, yyyy")</td>
                                <td>@term.EndDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @if (term.Status == "Active")
                                    {
                                        <span class="badge bg-success">@term.Status</span>
                                    }
                                    else if (term.Status == "Upcoming")
                                    {
                                        <span class="badge bg-info">@term.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@term.Status</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-primary">@term.CourseOfferings.Count</span>
                                </td>
                                <td>
                                    @if (term.IsActive)
                                    {
                                        <span class="status-badge active">
                                            <i class="bi bi-check-circle me-1"></i>Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge inactive">
                                            <i class="bi bi-x-circle me-1"></i>Inactive
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a asp-action="Details" asp-route-id="@term.Id" class="action-btn info" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@term.Id" class="action-btn warning" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (term.IsActive)
                                        {
                                            <form asp-action="Deactivate" asp-route-id="@term.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="action-btn danger" title="Deactivate"
                                                        onclick="return confirm('Are you sure you want to deactivate this term?')">
                                                    <i class="bi bi-slash-circle"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="Activate" asp-route-id="@term.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="action-btn success" title="Activate"
                                                        onclick="return confirm('Are you sure you want to activate this term?')">
                                                    <i class="bi bi-check-circle"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (ViewBag.Pagination != null)
            {
                @await Html.PartialAsync("_Pagination", ViewBag.Pagination as SmartClassRoom.Web.Models.ViewModels.Common.PaginationViewModel)
            }
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-calendar3"></i>
                <h3>No Terms Found</h3>
                <p>There are no academic terms matching your criteria.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Add First Term
                </a>
            </div>
        }
    </div>
</div>
