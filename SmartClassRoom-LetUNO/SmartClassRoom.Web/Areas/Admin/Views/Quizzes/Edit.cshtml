@model SmartClassRoom.Web.Models.ViewModels.Quizzes.UpdateQuizRequest
@{
    ViewData["Title"] = "Edit Quiz";
    ViewData["PageTitle"] = "Edit Quiz";
    ViewData["PageIcon"] = "pencil-square";
    ViewData["PageDescription"] = "Edit quiz details (questions cannot be edited)";
    Layout = "~/Views/Shared/_AdminLayoutWithSidebar.cshtml";
}

@section PageActions {
    <a asp-area="Admin" asp-controller="Quizzes" asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
}

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-3">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-info-circle me-2"></i>Quiz Details
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Quiz Title</label>
                        <input asp-for="Title" class="form-control" placeholder="e.g., Chapter 1 Quiz" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Optional quiz description"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="TimeLimit" class="form-label">Time Limit (minutes)</label>
                            <input asp-for="TimeLimit" type="number" class="form-control" min="1" max="300" />
                            <span asp-validation-for="TimeLimit" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="PassingScore" class="form-label">Passing Score (%)</label>
                            <input asp-for="PassingScore" type="number" class="form-control" min="0" max="100" step="any" />
                            <span asp-validation-for="PassingScore" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MaxAttempts" class="form-label">Max Attempts</label>
                        <input asp-for="MaxAttempts" type="number" class="form-control" min="1" max="10" placeholder="Leave empty for unlimited" />
                        <span asp-validation-for="MaxAttempts" class="text-danger"></span>
                        <div class="form-text">Leave empty for unlimited attempts</div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-check">
                                <input asp-for="ShuffleQuestions" class="form-check-input" type="checkbox" />
                                <label asp-for="ShuffleQuestions" class="form-check-label">Shuffle Questions</label>
                            </div>
                            <div class="form-text small">Randomize question order for each student</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-check">
                                <input asp-for="ShowCorrectAnswers" class="form-check-input" type="checkbox" />
                                <label asp-for="ShowCorrectAnswers" class="form-check-label">Show Correct Answers</label>
                            </div>
                            <div class="form-text small">Show correct answers after submission (if enabled)</div>
                        </div>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label">
                            Quiz is Active
                        </label>
                        <div class="form-text">Inactive quizzes cannot be assigned to new course offerings</div>
                    </div>
                </div>
            </div>

            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle me-2"></i>
                <strong>Note:</strong> Questions cannot be edited once a quiz is created. If you need to modify questions, create a new quiz.
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="bi bi-save me-1"></i> Update Quiz
                </button>
                <a asp-action="Index" class="btn btn-secondary btn-lg ms-2">
                    <i class="bi bi-x-circle me-1"></i> Cancel
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-3 sticky-top" style="top: 20px;">
                <div class="card-header bg-light">
                    <h6 class="card-title mb-0">
                        <i class="bi bi-info-circle me-2"></i>Quiz Summary
                    </h6>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled small">
                        <li class="mb-2">
                            <strong>Course:</strong> @ViewBag.CourseName
                        </li>
                        <li class="mb-2">
                            <strong>Questions:</strong> @ViewBag.QuestionCount
                        </li>
                        <li class="mb-2">
                            <strong>Total Points:</strong> @ViewBag.TotalPoints
                        </li>
                        <li class="mb-2">
                            <strong>Created:</strong> @ViewBag.CreatedAt
                        </li>
                        <li class="mb-2">
                            <strong>Created By:</strong> @ViewBag.CreatorName
                        </li>
                    </ul>

                    @if (ViewBag.HasActiveAssignments == true)
                    {
                        <hr />
                        <div class="alert alert-info small mb-0">
                            <i class="bi bi-info-circle me-1"></i>
                            This quiz has active assignments. Changes will affect future attempts only.
                        </div>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-header bg-light">
                    <h6 class="card-title mb-0">
                        <i class="bi bi-lightbulb me-2"></i>Edit Tips
                    </h6>
                </div>
                <div class="card-body">
                    <ul class="small text-muted mb-0">
                        <li class="mb-2">Only quiz settings can be edited</li>
                        <li class="mb-2">Questions are locked after creation</li>
                        <li class="mb-2">Changes apply to new attempts only</li>
                        <li class="mb-2">Deactivating a quiz prevents new assignments</li>
                        <li>Existing assignments remain active</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
