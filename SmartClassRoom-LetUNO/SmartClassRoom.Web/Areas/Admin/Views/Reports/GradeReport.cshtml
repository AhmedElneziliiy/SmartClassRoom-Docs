@{
    var offering = ViewBag.Offering as SmartClassRoom.Web.Models.Entities.Academic.CourseOffering;
    ViewData["Title"] = "Grade Report";
    ViewData["PageTitle"] = $"Grade Report - {offering?.Course.Code}";
    ViewData["PageDescription"] = $"Generate grade report for {offering?.Course.Name}";
    ViewData["PageIcon"] = "award";
}

<div class="card">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0">
            <i class="bi bi-award me-2"></i>
            Generate Grade Report
        </h5>
    </div>
    <div class="card-body">
        <div class="row mb-4">
            <div class="col-md-6">
                <h6 class="text-muted">Course Information</h6>
                <table class="table table-sm">
                    <tr>
                        <th width="40%">Course Code:</th>
                        <td>@offering?.Course.Code</td>
                    </tr>
                    <tr>
                        <th>Course Name:</th>
                        <td>@offering?.Course.Name</td>
                    </tr>
                    <tr>
                        <th>Teacher:</th>
                        <td>@offering?.Teacher.FullName</td>
                    </tr>
                    <tr>
                        <th>Term:</th>
                        <td>@offering?.Term.Name</td>
                    </tr>
                    <tr>
                        <th>Grade Components:</th>
                        <td>@(offering?.GradeComponents?.Count ?? 0) configured</td>
                    </tr>
                </table>
            </div>
            <div class="col-md-6">
                <h6 class="text-muted">Report Options</h6>
                <div class="alert alert-success">
                    <i class="bi bi-check-circle me-2"></i>
                    This report includes all grade components, final grades, letter grades, and class average.
                </div>
                <div class="d-grid gap-2">
                    <a asp-action="GenerateGradePdf"
                       asp-route-courseOfferingId="@offering?.Id"
                       class="btn btn-danger btn-lg">
                        <i class="bi bi-file-pdf me-2"></i>
                        Download PDF Report
                    </a>
                    <a asp-action="GenerateGradeExcel"
                       asp-route-courseOfferingId="@offering?.Id"
                       class="btn btn-success btn-lg">
                        <i class="bi bi-file-excel me-2"></i>
                        Download Excel Report
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-body">
        <h6 class="card-title">Report Contents</h6>
        <p class="text-muted">The grade report will include:</p>
        <ul class="text-muted">
            <li>Student list with student codes</li>
            <li>All grade component scores for each student</li>
            <li>Component weights and maximum scores</li>
            <li>Final calculated grade (percentage)</li>
            <li>Letter grade for each student</li>
            <li><strong>Class average</strong> across all students</li>
            <li>Course and term information</li>
            <li>Report generation date and time</li>
        </ul>
    </div>
</div>

<div class="card mt-4">
    <div class="card-body">
        <h6 class="card-title">Grade Components</h6>
        @if (offering?.GradeComponents != null && offering.GradeComponents.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Component Name</th>
                            <th>Weight (%)</th>
                            <th>Max Score</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var component in offering.GradeComponents)
                        {
                            <tr>
                                <td>@component.ComponentName</td>
                                <td>@component.Weight%</td>
                                <td>@component.MaxScore</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th>Total</th>
                            <th>@offering.GradeComponents.Sum(c => c.Weight)%</th>
                            <th>-</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle me-2"></i>
                No grade components configured yet.
            </div>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-2"></i>
        Back to Reports
    </a>
</div>

@section Styles {
    <style>
        .card-header {
            padding: 1rem 1.25rem;
        }

        .table th {
            color: #6c757d;
            font-weight: 500;
        }

        .table td {
            color: #212529;
        }

        .btn-lg {
            padding: 0.75rem 1.5rem;
            font-size: 1.1rem;
            font-weight: 500;
        }

        .alert-success {
            border-left: 4px solid #198754;
        }

        .table-bordered {
            border-color: #dee2e6;
        }
    </style>
}
