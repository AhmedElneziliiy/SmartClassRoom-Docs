@{
    var offering = ViewBag.Offering as SmartClassRoom.Web.Models.Entities.Academic.CourseOffering;
    ViewData["Title"] = "Attendance Report";
    ViewData["PageTitle"] = $"Attendance Report - {offering?.Course.Code}";
    ViewData["PageDescription"] = $"Generate attendance report for {offering?.Course.Name}";
    ViewData["PageIcon"] = "calendar-check";
}

<div class="card">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">
            <i class="bi bi-calendar-check me-2"></i>
            Generate Attendance Report
        </h5>
    </div>
    <div class="card-body">
        <div class="row mb-4">
            <div class="col-md-6">
                <h6 class="text-muted">Course Information</h6>
                <table class="table table-sm">
                    <tr>
                        <th width="40%">Course Code:</th>
                        <td>@offering?.Course.Code</td>
                    </tr>
                    <tr>
                        <th>Course Name:</th>
                        <td>@offering?.Course.Name</td>
                    </tr>
                    <tr>
                        <th>Teacher:</th>
                        <td>@offering?.Teacher.FullName</td>
                    </tr>
                    <tr>
                        <th>Term:</th>
                        <td>@offering?.Term.Name</td>
                    </tr>
                </table>
            </div>
            <div class="col-md-6">
                <h6 class="text-muted">Report Options</h6>
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    Select a date range to filter the report, or leave blank to include all sessions.
                </div>
            </div>
        </div>

        <form method="get" asp-action="GenerateAttendancePdf">
            <input type="hidden" name="courseOfferingId" value="@offering?.Id" />

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Date From</label>
                    <input type="date"
                           name="dateFrom"
                           class="form-control"
                           value="@offering?.Term.StartDate.ToString("yyyy-MM-dd")" />
                    <small class="text-muted">Start date for the report</small>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Date To</label>
                    <input type="date"
                           name="dateTo"
                           class="form-control"
                           value="@offering?.Term.EndDate.ToString("yyyy-MM-dd")" />
                    <small class="text-muted">End date for the report</small>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Export Format</label>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-file-pdf me-2"></i>
                            Download PDF
                        </button>
                        <button type="submit"
                                formaction="@Url.Action("GenerateAttendanceExcel")"
                                class="btn btn-success">
                            <i class="bi bi-file-excel me-2"></i>
                            Download Excel
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card mt-4">
    <div class="card-body">
        <h6 class="card-title">Report Contents</h6>
        <p class="text-muted">The attendance report will include:</p>
        <ul class="text-muted">
            <li>Student list with student codes</li>
            <li>Total number of sessions in the selected date range</li>
            <li>Attendance counts: Present, Absent, Late, Excused</li>
            <li>Attendance percentage for each student</li>
            <li>Course and term information</li>
            <li>Report generation date and time</li>
        </ul>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-2"></i>
        Back to Reports
    </a>
</div>

@section Styles {
    <style>
        .card-header {
            padding: 1rem 1.25rem;
        }

        .table th {
            color: #6c757d;
            font-weight: 500;
        }

        .table td {
            color: #212529;
        }

        .form-label {
            margin-bottom: 0.5rem;
        }

        small.text-muted {
            display: block;
            margin-top: 0.25rem;
        }

        .btn {
            font-weight: 500;
        }

        .alert-info {
            border-left: 4px solid #0dcaf0;
        }
    </style>
}
