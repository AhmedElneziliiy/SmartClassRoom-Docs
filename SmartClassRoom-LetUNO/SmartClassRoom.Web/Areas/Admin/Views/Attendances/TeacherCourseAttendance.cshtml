@model SmartClassRoom.Web.Models.ViewModels.Attendances.TeacherCourseAttendanceDto
@{
    ViewData["Title"] = "Teacher Course Attendance";
    ViewData["PageTitle"] = "Teacher Course Attendance";
    ViewData["PageIcon"] = "person-workspace";
    ViewData["PageDescription"] = $"Detailed attendance for {Model.TeacherName} in {Model.CourseName}";
    Layout = "~/Views/Shared/_AdminLayoutWithSidebar.cshtml";
}

@section PageActions {
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to Attendances
    </a>
}

<!-- Teacher & Course Information Cards -->
<div class="row mb-4">
    <!-- Teacher Info Card -->
    <div class="col-lg-6 mb-3">
        <div class="card info-card">
            <div class="card-header bg-warning bg-opacity-10">
                <h5 class="mb-0 text-warning">
                    <i class="bi bi-person-workspace me-2"></i>Teacher Information
                </h5>
            </div>
            <div class="card-body">
                <div class="info-grid">
                    <div class="info-item">
                        <span class="info-label">Name:</span>
                        <span class="info-value">@Model.TeacherName</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Code:</span>
                        <span class="info-value">@Model.TeacherCode</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Department:</span>
                        <span class="info-value">@Model.DepartmentName</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.TeacherEmail))
                    {
                        <div class="info-item">
                            <span class="info-label">Email:</span>
                            <span class="info-value">@Model.TeacherEmail</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.TeacherPhone))
                    {
                        <div class="info-item">
                            <span class="info-label">Phone:</span>
                            <span class="info-value">@Model.TeacherPhone</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Course Info Card -->
    <div class="col-lg-6 mb-3">
        <div class="card info-card">
            <div class="card-header bg-success bg-opacity-10">
                <h5 class="mb-0 text-success">
                    <i class="bi bi-book me-2"></i>Course Information
                </h5>
            </div>
            <div class="card-body">
                <div class="info-grid">
                    <div class="info-item">
                        <span class="info-label">Course:</span>
                        <span class="info-value">@Model.CourseName (@Model.CourseCode)</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Term:</span>
                        <span class="info-value">@Model.TermName</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Enrolled Students:</span>
                        <span class="info-value">@Model.TotalEnrolledStudents</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Total Sessions:</span>
                        <span class="info-value">@Model.TotalScheduledSessions</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Teaching Hours:</span>
                        <span class="info-value">@Model.TotalTeachingHours hours</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
<div class="stats-grid mb-4">
    <!-- Overall Attendance Card -->
    <div class="stat-card primary">
        <div class="stat-card-header">
            <div class="stat-card-content">
                <p class="stat-card-label">Overall Attendance</p>
                <h2 class="stat-card-value">@Model.AttendancePercentage%</h2>
                <div class="progress mt-2" style="height: 10px;">
                    <div class="progress-bar bg-primary" role="progressbar" style="width: @Model.AttendancePercentage%"></div>
                </div>
                <p class="stat-card-subtitle mt-2">
                    @Model.SessionsAttended / @Model.TotalScheduledSessions sessions
                </p>
            </div>
            <div class="stat-card-icon">
                <i class="bi bi-percent"></i>
            </div>
        </div>
    </div>

    <!-- Sessions Attended Card -->
    <div class="stat-card success">
        <div class="stat-card-header">
            <div class="stat-card-content">
                <p class="stat-card-label">Sessions Attended</p>
                <h2 class="stat-card-value">@Model.SessionsAttended</h2>
                <p class="stat-card-subtitle">@Math.Round((decimal)Model.SessionsAttended / Model.TotalScheduledSessions * 100, 1)% of total</p>
            </div>
            <div class="stat-card-icon">
                <i class="bi bi-check-circle"></i>
            </div>
        </div>
    </div>

    <!-- Sessions Missed Card -->
    <div class="stat-card danger">
        <div class="stat-card-header">
            <div class="stat-card-content">
                <p class="stat-card-label">Sessions Missed</p>
                <h2 class="stat-card-value">@Model.SessionsMissed</h2>
                <p class="stat-card-subtitle">@Math.Round((decimal)Model.SessionsMissed / Model.TotalScheduledSessions * 100, 1)% of total</p>
            </div>
            <div class="stat-card-icon">
                <i class="bi bi-x-circle"></i>
            </div>
        </div>
    </div>

    <!-- Late Arrivals Card -->
    <div class="stat-card warning">
        <div class="stat-card-header">
            <div class="stat-card-content">
                <p class="stat-card-label">Late Arrivals</p>
                <h2 class="stat-card-value">@Model.LateArrivals</h2>
                <p class="stat-card-subtitle">Avg: @Model.AverageLateMinutes min late</p>
            </div>
            <div class="stat-card-icon">
                <i class="bi bi-clock"></i>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row mb-4">
    <!-- Status Distribution Chart -->
    <div class="col-lg-6 mb-4">
        <div class="card chart-card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-pie-chart me-2"></i>Status Distribution
                </h5>
            </div>
            <div class="card-body">
                <canvas id="statusChart" style="max-height: 300px;"></canvas>
            </div>
        </div>
    </div>

    <!-- Monthly Breakdown Chart -->
    <div class="col-lg-6 mb-4">
        <div class="card chart-card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-bar-chart me-2"></i>Monthly Attendance
                </h5>
            </div>
            <div class="card-body">
                <canvas id="monthlyChart" style="max-height: 300px;"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Session Details Table -->
<div class="card">
    <div class="card-header bg-light">
        <h5 class="mb-0">
            <i class="bi bi-calendar3 me-2"></i>Session-by-Session Attendance
        </h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover session-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Room</th>
                        <th>Topic</th>
                        <th>Status</th>
                        <th>Check In</th>
                        <th>Check Out</th>
                        <th>Late</th>
                        <th>Student Attendance</th>
                        <th>Method</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Sessions.Count; i++)
                    {
                        var session = Model.Sessions[i];
                        <tr class="session-row @(session.Status == "Absent" ? "absent-row" : "")">
                            <td>@(i + 1)</td>
                            <td>
                                <strong>@session.SessionDate.ToString("MMM dd, yyyy")</strong>
                                <br>
                                <small class="text-muted">@session.SessionDate.ToString("dddd")</small>
                            </td>
                            <td>
                                <small>@session.ScheduledStartTime.ToString(@"hh\:mm") - @session.ScheduledEndTime.ToString(@"hh\:mm")</small>
                            </td>
                            <td>
                                <span class="badge bg-info bg-opacity-10 text-info">
                                    <i class="bi bi-door-open me-1"></i>@session.RoomName
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(session.Topic))
                                {
                                    <small>@session.Topic</small>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (session.Status == "Present")
                                {
                                    <span class="badge status-badge-present">
                                        <i class="bi bi-check-circle me-1"></i>Present
                                    </span>
                                }
                                else if (session.Status == "Absent")
                                {
                                    <span class="badge status-badge-absent">
                                        <i class="bi bi-x-circle me-1"></i>Absent
                                    </span>
                                }
                                else if (session.Status == "Late")
                                {
                                    <span class="badge status-badge-late">
                                        <i class="bi bi-clock me-1"></i>Late
                                    </span>
                                }
                            </td>
                            <td>
                                @if (session.ActualCheckInTime.HasValue)
                                {
                                    <small>@session.ActualCheckInTime.Value.ToString("HH:mm")</small>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (session.ActualCheckOutTime.HasValue)
                                {
                                    <small>@session.ActualCheckOutTime.Value.ToString("HH:mm")</small>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (session.MinutesLate.HasValue)
                                {
                                    <span class="badge bg-warning text-dark">+@session.MinutesLate min</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <div class="student-attendance-cell">
                                    <span class="badge @(session.StudentAttendanceRate >= 75 ? "bg-success" : session.StudentAttendanceRate >= 50 ? "bg-warning" : "bg-danger")">
                                        @session.StudentAttendanceRate%
                                    </span>
                                    <br>
                                    <small class="text-muted">@session.StudentsPresent/@session.TotalStudents</small>
                                </div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(session.VerificationMethod))
                                {
                                    @if (session.VerificationMethod == "Face")
                                    {
                                        <i class="bi bi-person-badge verification-face" title="Face Recognition"></i>
                                    }
                                    else if (session.VerificationMethod == "Manual")
                                    {
                                        <i class="bi bi-hand-index verification-manual" title="Manual"></i>
                                    }
                                    else if (session.VerificationMethod == "ESP32")
                                    {
                                        <i class="bi bi-cpu verification-esp32" title="ESP32"></i>
                                    }
                                    <small>@session.VerificationMethod</small>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    <script>
        // Status Distribution Chart
        const statusCtx = document.getElementById('statusChart');
        new Chart(statusCtx, {
            type: 'doughnut',
            data: {
                labels: ['Present', 'Absent', 'Late'],
                datasets: [{
                    data: [@Model.StatusDistribution["Present"], @Model.StatusDistribution["Absent"], @Model.StatusDistribution["Late"]],
                    backgroundColor: ['#28a745', '#dc3545', '#fd7e14'],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { padding: 15, font: { size: 12 } }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const percentage = ((context.parsed / total) * 100).toFixed(1);
                                return `${context.label}: ${context.parsed} (${percentage}%)`;
                            }
                        }
                    }
                }
            }
        });

        // Monthly Breakdown Chart
        const monthlyCtx = document.getElementById('monthlyChart');
        const monthlyData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyBreakdown));

        new Chart(monthlyCtx, {
            type: 'bar',
            data: {
                labels: monthlyData.map(m => m.month),
                datasets: [
                    {
                        label: 'Attended',
                        data: monthlyData.map(m => m.attendedSessions),
                        backgroundColor: '#28a745',
                        borderRadius: 6
                    },
                    {
                        label: 'Late',
                        data: monthlyData.map(m => m.lateArrivals),
                        backgroundColor: '#fd7e14',
                        borderRadius: 6
                    },
                    {
                        label: 'Missed',
                        data: monthlyData.map(m => m.missedSessions),
                        backgroundColor: '#dc3545',
                        borderRadius: 6
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                scales: {
                    x: { stacked: true, grid: { display: false } },
                    y: {
                        stacked: true,
                        beginAtZero: true,
                        ticks: { stepSize: 1, precision: 0 }
                    }
                },
                plugins: {
                    legend: {
                        position: 'top',
                        labels: { padding: 15, font: { size: 12 } }
                    }
                }
            }
        });
    </script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/student-teacher-attendance.css" asp-append-version="true" />
}
