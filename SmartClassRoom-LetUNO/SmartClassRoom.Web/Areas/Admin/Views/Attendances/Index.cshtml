@using SmartClassRoom.Web.Models.ViewModels.Attendances
@model IEnumerable<AttendanceDisplayDto>
@{
    ViewData["Title"] = "Attendances";
    ViewData["PageTitle"] = "Attendance Management";
    ViewData["PageIcon"] = "check2-square";
    ViewData["PageDescription"] = "Track and monitor student and teacher attendance";
    Layout = "~/Views/Shared/_AdminLayoutWithSidebar.cshtml";
}

<!-- Statistics Cards Grid (4 cards) -->
<div class="stats-grid mb-4">

    <!-- Card 1: Total Records (Primary - Blue) -->
    <div class="stat-card primary">
        <div class="stat-card-header">
            <div class="stat-card-content">
                <p class="stat-card-label">Total Records</p>
                <h2 class="stat-card-value">@ViewBag.TotalRecords</h2>
                <p class="stat-card-subtitle">
                    Students: @ViewBag.StudentRecords | Teachers: @ViewBag.TeacherRecords
                </p>
            </div>
            <div class="stat-card-icon">
                <i class="bi bi-check2-square"></i>
            </div>
        </div>
    </div>

    <!-- Card 2: Overall Attendance Rate (Success - Green) -->
    <div class="stat-card success">
        <div class="stat-card-header">
            <div class="stat-card-content">
                <p class="stat-card-label">Attendance Rate</p>
                <h2 class="stat-card-value">@ViewBag.AverageAttendanceRate%</h2>
                <div class="progress mt-2" style="height: 8px;">
                    <div class="progress-bar bg-success" role="progressbar"
                         style="width: @ViewBag.AverageAttendanceRate%"></div>
                </div>
                <p class="stat-card-subtitle mt-2">
                    <small>Students: @ViewBag.StudentAttendanceRate% | Teachers: @ViewBag.TeacherAttendanceRate%</small>
                </p>
            </div>
            <div class="stat-card-icon">
                <i class="bi bi-graph-up-arrow"></i>
            </div>
        </div>
    </div>

    <!-- Card 3: Status Breakdown (Info - Teal) -->
    <div class="stat-card info">
        <div class="stat-card-header">
            <div class="stat-card-content">
                <p class="stat-card-label">Status Breakdown</p>
                <div class="status-breakdown">
                    <div class="status-item">
                        <i class="bi bi-check-circle text-success"></i>
                        <span>Present: @ViewBag.PresentCount (@ViewBag.PresentPercentage%)</span>
                    </div>
                    <div class="status-item">
                        <i class="bi bi-x-circle text-danger"></i>
                        <span>Absent: @ViewBag.AbsentCount (@ViewBag.AbsentPercentage%)</span>
                    </div>
                    <div class="status-item">
                        <i class="bi bi-clock text-warning"></i>
                        <span>Late: @ViewBag.LateCount (@ViewBag.LatePercentage%)</span>
                    </div>
                    <div class="status-item">
                        <i class="bi bi-clipboard-check text-info"></i>
                        <span>Excused: @ViewBag.ExcusedCount (@ViewBag.ExcusedPercentage%)</span>
                    </div>
                </div>
            </div>
            <div class="stat-card-icon">
                <i class="bi bi-pie-chart"></i>
            </div>
        </div>
    </div>

    <!-- Card 4: Verification Methods (Warning - Purple) -->
    <div class="stat-card warning">
        <div class="stat-card-header">
            <div class="stat-card-content">
                <p class="stat-card-label">Verification Methods</p>
                <div class="verification-breakdown">
                    <div class="verification-item">
                        <i class="bi bi-person-badge verification-face"></i>
                        <span>Face: @ViewBag.FaceVerificationPercentage%</span>
                    </div>
                    <div class="verification-item">
                        <i class="bi bi-hand-index verification-manual"></i>
                        <span>Manual: @ViewBag.ManualVerificationPercentage%</span>
                    </div>
                    <div class="verification-item">
                        <i class="bi bi-cpu verification-esp32"></i>
                        <span>ESP32: @ViewBag.ESP32VerificationPercentage%</span>
                    </div>
                </div>
            </div>
            <div class="stat-card-icon">
                <i class="bi bi-shield-check"></i>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row (2 columns) -->
<div class="row mb-4">

    <!-- Left Column: Status Distribution Chart -->
    <div class="col-lg-6 mb-4">
        <div class="card chart-card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-pie-chart me-2"></i>Attendance Status Distribution
                </h5>
            </div>
            <div class="card-body">
                <canvas id="attendanceStatusChart" style="max-height: 300px;"></canvas>
            </div>
        </div>
    </div>

    <!-- Right Column: Attendance Trends Chart -->
    <div class="col-lg-6 mb-4">
        <div class="card chart-card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-graph-up me-2"></i>30-Day Attendance Trend
                </h5>
            </div>
            <div class="card-body">
                <canvas id="attendanceTrendChart" style="max-height: 300px;"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Filters Card -->
<div class="card mb-4">
    <div class="card-header bg-light">
        <h5 class="mb-0">
            <i class="bi bi-funnel me-2"></i>Filters
        </h5>
    </div>
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="filter-row">
                <div class="form-group">
                    <label>Start Date</label>
                    <input type="date" name="startDate" class="form-control" value="@ViewBag.StartDate">
                </div>
                <div class="form-group">
                    <label>End Date</label>
                    <input type="date" name="endDate" class="form-control" value="@ViewBag.EndDate">
                </div>
                <div class="form-group">
                    <label>Attendance Type</label>
                    <select name="attendanceType" class="form-select">
                        <option value="">Both (Student & Teacher)</option>
                        <option value="Student">Student Only</option>
                        <option value="Teacher">Teacher Only</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Status</label>
                    <select name="status" class="form-select">
                        <option value="">All Statuses</option>
                        @foreach (var status in ViewBag.StatusOptions)
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Verification Method</label>
                    <select name="verificationMethod" class="form-select">
                        <option value="">All Methods</option>
                        @foreach (var method in ViewBag.VerificationMethods)
                        {
                            <option value="@method">@method</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Course</label>
                    <select name="courseId" class="form-select">
                        <option value="">All Courses</option>
                        @foreach (var course in ViewBag.Courses)
                        {
                            <option value="@course.Value">@course.Text</option>
                        }
                    </select>
                </div>
                <div class="form-group align-self-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i> Apply Filters
                    </button>
                </div>
                <div class="form-group align-self-end">
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-x-circle me-1"></i> Clear
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Recent Attendance Records Table -->
<div class="card">
    <div class="card-header bg-light">
        <h5 class="mb-0">
            <i class="bi bi-list-ul me-2"></i>Recent Attendance Records
        </h5>
    </div>
    <div class="card-body">
        @if (ViewBag.RecentRecords != null && ViewBag.RecentRecords.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-hover attendance-table">
                    <thead>
                        <tr>
                            <th>Date/Time</th>
                            <th>Type</th>
                            <th>Name</th>
                            <th>Course</th>
                            <th>Session Time</th>
                            <th>Status</th>
                            <th>Verification</th>
                            <th>Check Out</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in ViewBag.RecentRecords)
                        {
                            <tr class="attendance-row">
                                <td>
                                    <small>@record.CheckInTime.ToString("MMM dd, HH:mm")</small>
                                </td>
                                <td>
                                    <span class="@(record.Type == "Student" ? "student-type" : "teacher-type")">
                                        @record.Type
                                    </span>
                                </td>
                                <td>@record.Name</td>
                                <td>
                                    <span class="badge bg-primary bg-opacity-10 text-primary">
                                        @record.CourseName
                                    </span>
                                </td>
                                <td>
                                    <small class="text-muted">@record.SessionTime</small>
                                </td>
                                <td>
                                    @if (record.Status == "Present")
                                    {
                                        <span class="badge status-badge-present">
                                            <i class="bi bi-check-circle me-1"></i>Present
                                        </span>
                                    }
                                    else if (record.Status == "Absent")
                                    {
                                        <span class="badge status-badge-absent">
                                            <i class="bi bi-x-circle me-1"></i>Absent
                                        </span>
                                    }
                                    else if (record.Status == "Late")
                                    {
                                        <span class="badge status-badge-late">
                                            <i class="bi bi-clock me-1"></i>Late
                                        </span>
                                    }
                                    else if (record.Status == "Excused")
                                    {
                                        <span class="badge status-badge-excused">
                                            <i class="bi bi-clipboard-check me-1"></i>Excused
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (record.VerificationMethod == "Face")
                                    {
                                        <i class="bi bi-person-badge verification-face" title="Face Recognition"></i>
                                    }
                                    else if (record.VerificationMethod == "Manual")
                                    {
                                        <i class="bi bi-hand-index verification-manual" title="Manual"></i>
                                    }
                                    else if (record.VerificationMethod == "ESP32")
                                    {
                                        <i class="bi bi-cpu verification-esp32" title="ESP32"></i>
                                    }
                                    <small>@record.VerificationMethod</small>
                                </td>
                                <td>
                                    @if (record.CheckOutTime.HasValue)
                                    {
                                        <small>@record.CheckOutTime.Value.ToString("HH:mm")</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                No attendance records found for the selected criteria.
            </div>
        }
    </div>
</div>

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    <!-- Attendances Charts JavaScript -->
    <script src="~/js/attendances-charts.js" asp-append-version="true"></script>

    <script>
        // Initialize charts with data from ViewBag
        if (typeof AttendancesCharts !== 'undefined') {
            var statusData = {
                present: @ViewBag.PresentCount,
                absent: @ViewBag.AbsentCount,
                late: @ViewBag.LateCount,
                excused: @ViewBag.ExcusedCount
            };

            var trendData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.TrendData));

            AttendancesCharts.init({
                statusData: statusData,
                trendData: trendData
            });
        }
    </script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/attendances.css" asp-append-version="true" />
}
