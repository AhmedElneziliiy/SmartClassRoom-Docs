@model List<SmartClassRoom.Web.Models.ViewModels.Timetables.ConflictInfo>
@{
    var timetable = ViewBag.Timetable as SmartClassRoom.Web.Models.Entities.Scheduling.Timetable;
    ViewData["Title"] = $"Conflicts - {timetable?.Name}";
    ViewData["PageTitle"] = "Conflict Report";
    ViewData["PageIcon"] = "exclamation-triangle";
    ViewData["PageDescription"] = $"{timetable?.Name}";
    Layout = "~/Views/Shared/_AdminLayoutWithSidebar.cshtml";
}

@section PageActions {
    <a asp-area="Admin" asp-controller="Timetables" asp-action="Details" asp-route-id="@timetable.Id" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to Timetable
    </a>
}

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-check-circle text-success" style="font-size: 5rem;"></i>
            <h3 class="mt-4 text-success">No Conflicts Detected!</h3>
            <p class="text-muted">This timetable is ready to be published.</p>
            <form asp-area="Admin" asp-controller="Timetables" asp-action="Publish" asp-route-id="@timetable.Id" method="post" class="mt-3">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success btn-lg"
                        onclick="return confirm('Are you sure you want to publish this timetable?');">
                    <i class="bi bi-check-circle me-2"></i>Publish Timetable
                </button>
            </form>
        </div>
    </div>
}
else
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <strong>@Model.Count Conflict(s) Detected!</strong>
        You must resolve all conflicts before publishing this timetable.
    </div>

    <!-- Conflict Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-danger">
                <div class="card-body text-center">
                    <i class="bi bi-person-x text-danger" style="font-size: 2rem;"></i>
                    <h6 class="mt-2 mb-1">Teacher Conflicts</h6>
                    <h3 class="text-danger mb-0">@Model.Count(c => c.ConflictType == "Teacher")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-warning">
                <div class="card-body text-center">
                    <i class="bi bi-people-fill text-warning" style="font-size: 2rem;"></i>
                    <h6 class="mt-2 mb-1">Section Conflicts</h6>
                    <h3 class="text-warning mb-0">@Model.Count(c => c.ConflictType == "Section")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-info">
                <div class="card-body text-center">
                    <i class="bi bi-door-closed text-info" style="font-size: 2rem;"></i>
                    <h6 class="mt-2 mb-1">Room Conflicts</h6>
                    <h3 class="text-info mb-0">@Model.Count(c => c.ConflictType == "Room")</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Detailed Conflict List -->
    <div class="card">
        <div class="card-header bg-danger text-white">
            <h5 class="card-title mb-0">
                <i class="bi bi-list-ul me-2"></i>Conflict Details
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="users-table">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Resource</th>
                            <th>Day & Time</th>
                            <th>Affected Courses</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var conflict in Model.OrderBy(c => c.ConflictType).ThenBy(c => c.DayOfWeek).ThenBy(c => c.StartTime))
                        {
                            <tr>
                                <td>
                                    @if (conflict.ConflictType == "Teacher")
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-person-x me-1"></i>Teacher
                                        </span>
                                    }
                                    else if (conflict.ConflictType == "Section")
                                    {
                                        <span class="badge bg-warning">
                                            <i class="bi bi-people-fill me-1"></i>Section
                                        </span>
                                    }
                                    else if (conflict.ConflictType == "Room")
                                    {
                                        <span class="badge bg-info">
                                            <i class="bi bi-door-closed me-1"></i>Room
                                        </span>
                                    }
                                </td>
                                <td><strong>@conflict.Resource</strong></td>
                                <td>
                                    <span class="badge bg-secondary">@conflict.DayOfWeek</span>
                                    <br />
                                    <small class="text-muted">
                                        @conflict.StartTime.ToString(@"hh\:mm") - @conflict.EndTime.ToString(@"hh\:mm")
                                    </small>
                                </td>
                                <td>
                                    @foreach (var course in conflict.AffectedCourses)
                                    {
                                        <span class="badge bg-primary me-1 mb-1">@course</span>
                                    }
                                </td>
                                <td>
                                    <small class="text-muted">@conflict.Description</small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-body">
            <h6 class="card-title"><i class="bi bi-info-circle me-2"></i>How to Resolve Conflicts</h6>
            <ul class="mb-0">
                <li><strong>Teacher Conflicts:</strong> A teacher is scheduled for multiple courses at the same time. Move one of the conflicting courses to a different time slot.</li>
                <li><strong>Section Conflicts:</strong> A section has multiple courses scheduled at the same time. Move one of the conflicting courses to a different time slot.</li>
                <li><strong>Room Conflicts:</strong> A room is booked for multiple courses at the same time. Assign a different room to one of the courses.</li>
            </ul>
            <div class="mt-3">
                <a asp-area="Admin" asp-controller="Timetables" asp-action="Details" asp-route-id="@timetable.Id" class="btn btn-primary">
                    <i class="bi bi-pencil-square me-2"></i>Edit Timetable to Resolve Conflicts
                </a>
            </div>
        </div>
    </div>
}
