@model SmartClassRoom.Web.Models.Entities.Scheduling.Room

@{
    ViewData["Title"] = "Room Details";
    ViewData["PageTitle"] = $"Room {Model.Number}";
    ViewData["PageIcon"] = "door-open";
    Layout = "~/Views/Shared/_AdminLayoutWithSidebar.cshtml";
    var statistics = ViewBag.Statistics as SmartClassRoom.Web.Models.ViewModels.Room.RoomStatistics;
}

@section PageActions {
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
        <i class="bi bi-pencil"></i> Edit
    </a>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
}

<div class="row g-4">
    <!-- Left Column: Room Info -->
    <div class="col-lg-4">
        <div class="card detail-card mb-4">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="bi bi-info-circle"></i> Room Information
                </h5>

                <div class="detail-group">
                    <label>Room Number</label>
                    <p><strong>@Model.Number</strong></p>
                </div>

                @if (!string.IsNullOrEmpty(Model.Name))
                {
                    <div class="detail-group">
                        <label>Name</label>
                        <p>@Model.Name</p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.RoomType))
                {
                    <div class="detail-group">
                        <label>Type</label>
                        <p><span class="badge bg-secondary">@Model.RoomType</span></p>
                    </div>
                }

                <div class="detail-group">
                    <label>Capacity</label>
                    <p>
                        <span class="badge bg-info">
                            <i class="bi bi-people"></i> @Model.Capacity
                        </span>
                    </p>
                </div>

                @if (!string.IsNullOrEmpty(Model.Building))
                {
                    <div class="detail-group">
                        <label>Building</label>
                        <p><i class="bi bi-building"></i> @Model.Building</p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Floor))
                {
                    <div class="detail-group">
                        <label>Floor</label>
                        <p>@Model.Floor</p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Equipment))
                {
                    <div class="detail-group">
                        <label>Equipment</label>
                        <p>@Model.Equipment</p>
                    </div>
                }

                <div class="detail-group">
                    <label>Status</label>
                    <p>
                        @if (Model.IsActive)
                        {
                            <span class="status-badge active">
                                <i class="bi bi-check-circle me-1"></i>Active
                            </span>
                        }
                        else
                        {
                            <span class="status-badge inactive">
                                <i class="bi bi-x-circle me-1"></i>Inactive
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(Model.Status))
                        {
                            <span class="badge bg-secondary ms-2">@Model.Status</span>
                        }
                    </p>
                </div>
            </div>
        </div>

        <!-- Device Configuration Card -->
        <div class="card detail-card mb-4">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="bi bi-cpu"></i> Device Configuration
                </h5>

                <div class="detail-group">
                    <label>Device ID (Modulation Number)</label>
                    <p>
                        @if (!string.IsNullOrEmpty(Model.DeviceId))
                        {
                            <span class="badge bg-primary fs-6">
                                <i class="bi bi-router me-1"></i> @Model.DeviceId
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                <i class="bi bi-info-circle me-1"></i>
                                Not set - will be set by first device added
                            </span>
                        }
                    </p>
                </div>

                <div class="detail-group">
                    <label>Total Devices</label>
                    <p>
                        <span class="badge bg-success fs-6">
                            @Model.ESPDevices.Count <i class="bi bi-router"></i>
                        </span>
                    </p>
                </div>
            </div>
        </div>

        <!-- Actions Card -->
        <div class="card detail-card">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="bi bi-gear"></i> Actions
                </h5>

                <div class="detail-actions">
                    <button type="button" class="btn btn-success btn-sm w-100 mb-2" data-bs-toggle="modal" data-bs-target="#addDeviceModal">
                        <i class="bi bi-plus-circle"></i> Add Device
                    </button>

                    @if (Model.IsActive)
                    {
                        <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-warning btn-sm w-100"
                                    onclick="return confirm('Are you sure you want to deactivate this room?')">
                                <i class="bi bi-slash-circle"></i> Deactivate Room
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Activate" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success btn-sm w-100"
                                    onclick="return confirm('Are you sure you want to activate this room?')">
                                <i class="bi bi-check-circle"></i> Activate Room
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Statistics and Devices -->
    <div class="col-lg-8">
        <!-- Statistics Card -->
        @if (statistics != null)
        {
            <div class="card stats-card mb-4">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-graph-up"></i> Statistics
                    </h5>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="stat-item">
                                <div class="stat-icon bg-primary">
                                    <i class="bi bi-router"></i>
                                </div>
                                <div class="stat-details">
                                    <span class="stat-label">ESP Devices</span>
                                    <span class="stat-value">@statistics.DevicesCount</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="stat-item">
                                <div class="stat-icon bg-info">
                                    <i class="bi bi-calendar-event"></i>
                                </div>
                                <div class="stat-details">
                                    <span class="stat-label">Scheduled Slots</span>
                                    <span class="stat-value">@statistics.ScheduledSlotsCount</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="stat-item">
                                <div class="stat-icon bg-success">
                                    <i class="bi bi-journal-check"></i>
                                </div>
                                <div class="stat-details">
                                    <span class="stat-label">Total Sessions</span>
                                    <span class="stat-value">@statistics.SessionsCount</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="stat-item">
                                <div class="stat-icon bg-warning">
                                    <i class="bi bi-play-circle"></i>
                                </div>
                                <div class="stat-details">
                                    <span class="stat-label">Active Sessions</span>
                                    <span class="stat-value">@statistics.ActiveSessionsCount</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- ESP Devices Card -->
        <div class="card data-card mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-router"></i> ESP Devices
                    </h5>
                    <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#addDeviceModal">
                        <i class="bi bi-plus-circle"></i> Add Device
                    </button>
                </div>

                @if (Model.ESPDevices.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Device Name</th>
                                    <th>Device ID</th>
                                    <th>MAC Address</th>
                                    <th>IP Address</th>
                                    <th>Status</th>
                                    <th>Last Seen</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var device in Model.ESPDevices.OrderByDescending(d => d.RegisteredAt))
                                {
                                    <tr>
                                        <td><strong>@device.DeviceName</strong></td>
                                        <td>
                                            <span class="badge bg-primary">@device.DeviceId</span>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(device.MacAddress))
                                            {
                                                <code>@device.MacAddress</code>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(device.IPAddress))
                                            {
                                                <code>@device.IPAddress</code>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (device.Status == "Active")
                                            {
                                                <span class="status-badge active">Active</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge inactive">@device.Status</span>
                                            }
                                        </td>
                                        <td>
                                            @if (device.LastSeen.HasValue)
                                            {
                                                <span title="@device.LastSeen.Value.ToString("g")">
                                                    @device.LastSeen.Value.ToString("MMM dd, HH:mm")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Never</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <form asp-action="RemoveDevice" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="roomId" value="@Model.Id" />
                                                <input type="hidden" name="deviceId" value="@device.Id" />
                                                <button type="submit" class="action-btn danger" title="Remove Device"
                                                        onclick="return confirm('Are you sure you want to remove this device from the room?')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state-small">
                        <i class="bi bi-router"></i>
                        <p>No devices configured for this room.</p>
                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addDeviceModal">
                            <i class="bi bi-plus-circle"></i> Add First Device
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- Sessions Card -->
        <div class="card data-card">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="bi bi-journal-check"></i> Recent Sessions
                </h5>

                @if (Model.Sessions.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Session</th>
                                    <th>Status</th>
                                    <th>Started</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var session in Model.Sessions.OrderByDescending(s => s.CreatedAt).Take(10))
                                {
                                    <tr>
                                        <td><strong>Session #@session.Id</strong></td>
                                        <td>
                                            @if (session.Status == "Active" || session.Status == "InProgress")
                                            {
                                                <span class="status-badge active">@session.Status</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge inactive">@session.Status</span>
                                            }
                                        </td>
                                        <td>@session.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (Model.Sessions.Count > 10)
                    {
                        <div class="text-center mt-3">
                            <span class="text-muted">Showing 10 of @Model.Sessions.Count sessions</span>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state-small">
                        <i class="bi bi-journal-check"></i>
                        <p>No sessions have been held in this room.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Add Device Modal -->
<div class="modal fade" id="addDeviceModal" tabindex="-1" aria-labelledby="addDeviceModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddDevice" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="RoomId" value="@Model.Id" />

                <div class="modal-header">
                    <h5 class="modal-title" id="addDeviceModalLabel">
                        <i class="bi bi-router me-2"></i>Add ESP Device to Room @Model.Number
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(Model.DeviceId))
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            This room uses Device ID <strong>@Model.DeviceId</strong>. The new device must have the same Device ID.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            This is the first device for this room. The Device ID you enter will be used for all future devices in this room.
                        </div>
                    }

                    <div class="mb-3">
                        <label for="DeviceId" class="form-label">Device ID (Modulation Number) <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="DeviceId" name="DeviceId"
                               value="@Model.DeviceId" @(string.IsNullOrEmpty(Model.DeviceId) ? "" : "readonly")
                               placeholder="Enter device modulation number" required />
                        <div class="form-text">Unique identifier used for communication between devices in this room.</div>
                    </div>

                    <div class="mb-3">
                        <label for="MacAddress" class="form-label">MAC Address</label>
                        <input type="text" class="form-control" id="MacAddress" name="MacAddress"
                               placeholder="e.g., AA:BB:CC:DD:EE:FF" />
                        <div class="form-text">Physical address of the ESP device (optional).</div>
                    </div>

                    <div class="mb-3">
                        <label for="IPAddress" class="form-label">IP Address</label>
                        <input type="text" class="form-control" id="IPAddress" name="IPAddress"
                               placeholder="e.g., 192.168.1.100" />
                        <div class="form-text">Network IP address of the ESP device (optional).</div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle"></i> Cancel
                    </button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-plus-circle"></i> Add Device
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
