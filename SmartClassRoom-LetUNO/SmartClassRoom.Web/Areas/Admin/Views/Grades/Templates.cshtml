@model IEnumerable<SmartClassRoom.Web.Models.ViewModels.Grading.GradeComponentTemplateDto>
@{
    ViewData["Title"] = "Grade Component Templates";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-12 d-flex justify-content-between align-items-center">
            <h2>Grade Component Templates</h2>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createTemplateModal">
                <i class="bi bi-plus-circle"></i> Create Template
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        @if (Model.Any())
        {
            @foreach (var template in Model)
            {
                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">@template.TemplateName</h5>
                            <span class="badge bg-secondary">@template.ComponentCount components</span>
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(template.Description))
                            {
                                <p class="text-muted small">@template.Description</p>
                            }
                            @if (!string.IsNullOrEmpty(template.DepartmentName))
                            {
                                <p class="small mb-2"><strong>Department:</strong> @template.DepartmentName</p>
                            }
                            else
                            {
                                <p class="small mb-2"><strong>Department:</strong> <span class="text-muted">Global</span></p>
                            }
                            <hr />
                            <ul class="list-unstyled small">
                                @foreach (var component in template.Components.OrderBy(c => c.OrderIndex))
                                {
                                    <li class="mb-1">
                                        <strong>@component.ComponentName:</strong> @component.Weight% (max: @component.MaxScore pts)
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info">
                    No templates created yet. Create a template to reuse grade component structures across multiple course offerings.
                </div>
            </div>
        }
    </div>
</div>

<!-- Create Template Modal -->
<div class="modal fade" id="createTemplateModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create Component Template</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="SaveTemplate" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Template Name</label>
                        <input type="text" name="TemplateName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="Description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Components</label>
                        <div id="templateComponentsContainer">
                            <!-- Components will be added dynamically -->
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary mt-2" onclick="addTemplateComponent()">
                            <i class="bi bi-plus"></i> Add Component
                        </button>
                    </div>
                    <div class="alert alert-info small">
                        <strong>Note:</strong> Component weights must total 100%. This template can be applied to any course offering.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Template</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let templateComponentIndex = 0;

        function addTemplateComponent(data = null) {
            const container = document.getElementById('templateComponentsContainer');
            const index = templateComponentIndex++;

            const html = `
                <div class="card mb-2" id="template-component-${index}">
                    <div class="card-body p-2">
                        <div class="row g-2 align-items-end">
                            <div class="col-md-4">
                                <label class="form-label small">Component Name</label>
                                <input type="text" name="Components[${index}].ComponentName" class="form-control form-control-sm"
                                       value="${data?.componentName || ''}" required />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small">Weight (%)</label>
                                <input type="number" name="Components[${index}].Weight" class="form-control form-control-sm"
                                       value="${data?.weight || ''}" step="0.01" min="0.01" max="100" required />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small">Max Score</label>
                                <input type="number" name="Components[${index}].MaxScore" class="form-control form-control-sm"
                                       value="${data?.maxScore || 100}" step="0.01" min="1" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Description</label>
                                <input type="text" name="Components[${index}].Description" class="form-control form-control-sm"
                                       value="${data?.description || ''}" />
                            </div>
                            <div class="col-md-1">
                                <button type="button" class="btn btn-sm btn-danger w-100" onclick="removeTemplateComponent(${index})">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                            <input type="hidden" name="Components[${index}].OrderIndex" value="${index}" />
                        </div>
                    </div>
                </div>
            `;

            container.insertAdjacentHTML('beforeend', html);
        }

        function removeTemplateComponent(index) {
            document.getElementById(`template-component-${index}`).remove();
        }

        // Add initial component when modal opens
        document.getElementById('createTemplateModal').addEventListener('show.bs.modal', function () {
            if (templateComponentIndex === 0) {
                addTemplateComponent();
            }
        });
    </script>
}
